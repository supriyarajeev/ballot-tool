    "type": "Official"
   }
  ],
  "plainEnglish": "Raises Gilroy's hotel tax from 9% to 11% starting January 1, 2027, and lets the City Council set the rate up to a maximum of 13%. The ballot question estimates $700,000 a year, and the tax continues until ended by voters.",
  "yes": null,
  "no": null,
  "fiscal": null,
  "jurisdictionName": "Gilroy"
 },

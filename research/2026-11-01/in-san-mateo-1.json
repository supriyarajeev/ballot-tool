 {
  "id": "2026-11-03.ca-san-mateo.measure-j",
  "jurisdiction": "ca-san-mateo",
  "identifier": "Measure J",
  "shortTitle": "San Mateo County Charter Amendment Measure – Extension to Call a Special Election or Appoint",
  "officialTitle": null,
  "measureType": "Charter amendment",
  "threshold": "a simple majority (more than 50%) of votes",
  "ballotQuestion": "Shall the San Mateo County Charter be amended to extend the period in which the County Board of Supervisors is required to either call a special election or make an appointment in the event of a vacancy in an elected office other than the Board of Supervisors from 30 days to 60 days, and to require the Board to conduct at least one public meeting to receive public comment prior to any appointment?",
  "sources": [
   {
    "label": "San Mateo County official election page, local measures",
    "url": "https://smcacre.gov/elections/november-3-2026-statewide-general-election",
    "type": "Official"
   },
   {
    "label": "Official document with the ballot question",
    "url": "https://smcacre.gov/system/files/2026-07/San%20Mateo%20County%20Amendments.pdf",
    "type": "Official"
   },
   {
    "label": "Impartial analysis (official)",
    "url": "https://smcacre.gov/system/files/2026-08/52-ENG-MJ-ImpartialAnalysis-SMC-Charter-Extension-to-Call%20Special%20Election.pdf",
    "type": "Official"
   }
  ],
  "plainEnglish": "Gives the Board of Supervisors 60 days instead of 30 to call a special election or make an appointment when an elected office other than the Board becomes vacant. The Board would have to hold at least one public meeting for public comment before any appointment.",
  "yes": null,
  "no": null,
  "fiscal": null,
  "jurisdictionName": "San Mateo County"
 },
